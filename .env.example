# ============================================================
#  로컬(집 컴퓨터)에서 쓸 때는 아래 두 칸만 있으면 됩니다.
# ============================================================

# ---- DART 전자공시 (국내에서 가장 빠른 소스, 사실상 필수) ----
# https://opendart.fss.or.kr 에서 무료 발급 -> 인증키 신청/관리 -> 오픈API 이용현황
OPENDART_API_KEY=

# ---- 알림 (요구사항 20) ----
# 텔레그램 @BotFather 에서 봇을 만들고 토큰을 받습니다.
# 비워두면 알림은 서버 로그로만 남고, 수집 자체는 정상 동작합니다.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# CRITICAL | HIGH | MEDIUM | LOW  (이 등급 이상만 알림)
ALERT_MIN_SEVERITY=HIGH


# ============================================================
#  클라우드 서버에 올릴 때만 추가로 채웁니다 (docs/DEPLOY.md 참고)
# ============================================================

# 접속할 주소. 도메인이 있어야 HTTPS 인증서가 자동 발급됩니다.
# 예: biotrial.duckdns.org
SITE_ADDRESS=
SITE_URL=

# 앱에 들어갈 때 물어볼 아이디/비밀번호
APP_USER=father
# 비밀번호는 해시로 넣습니다. 아래 명령으로 만드세요:
#   docker run --rm caddy caddy hash-password --plaintext '원하는비밀번호'
APP_PASSWORD_HASH=

# 데이터베이스 비밀번호 (아무 긴 문자열이면 됩니다)
#   openssl rand -base64 24
POSTGRES_PASSWORD=


# ============================================================
#  Phase 2 이후에 쓸 것들
# ============================================================
# 공공데이터포털(식약처 임상시험 정보). https://www.data.go.kr 무료 발급
DATA_GO_KR_API_KEY=
# 선택. 없어도 동작하며 있으면 호출 한도만 올라갑니다.
OPENFDA_API_KEY=

# ---- 이메일 알림 (앱 등록도 만료도 없는 가장 간단한 방법) ----
# 지메일이면 '앱 비밀번호' 를 씁니다. 평소 로그인 비밀번호가 아닙니다.
#   구글 계정 -> 보안 -> 2단계 인증 켜기 -> 앱 비밀번호 -> 16자리 발급
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_TO=
# 보통 비워두면 됩니다 (주소 도메인 보고 자동으로 잡습니다)
SMTP_HOST=
SMTP_PORT=587
