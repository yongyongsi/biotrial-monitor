# 리버스 프록시 + 자동 HTTPS + 비밀번호 잠금
#
# {$SITE_ADDRESS} 에 도메인을 넣으면 Let's Encrypt 인증서를 자동으로 받아온다.
# 도메인이 없으면 :80 으로 두고 Cloudflare Tunnel 을 앞에 붙여도 된다.

{$SITE_ADDRESS} {
	encode gzip

	# 개인용 앱이므로 전체를 비밀번호로 잠근다.
	# 해시 만들기:
	#   docker run --rm caddy caddy hash-password --plaintext '원하는비밀번호'
	basic_auth {
		{$APP_USER} {$APP_PASSWORD_HASH}
	}

	# API 는 백엔드로
	handle /api/* {
		reverse_proxy backend:8000
	}
	handle /docs* {
		reverse_proxy backend:8000
	}
	handle /openapi.json {
		reverse_proxy backend:8000
	}

	# 나머지는 화면으로
	handle {
		reverse_proxy frontend:3000
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy no-referrer-when-downgrade
	}
}
